# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# ── Model providers ───────────────────────────────────────────────────────────
# At least one is required. Every key you add shows up in the composer's model
# picker, and the runtime fails over between them when one hits its quota.

# Gemini — https://aistudio.google.com/apikey  (REQUIRED; generous free tier)
GEMINI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys  (STRONGLY RECOMMENDED)
# Adds Claude Haiku / Sonnet / Opus and makes Haiku the default: the best
# tool-use quality in the cheap tier.
ANTHROPIC_API_KEY=

# Groq — https://console.groq.com/keys  (optional, free)
# Llama 3.3 70B. Worth setting even if unused: it gives the quota failover
# somewhere to go when the Gemini free tier is exhausted.
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai  (optional, free tier)  — wafer-scale, very
# fast OpenAI-compatible inference. Seeds cerebras:gpt-oss-120b (best tool use) into
# the picker when set. Free tier = 65k context, enough for the full tool list + a turn.
CEREBRAS_API_KEY=

# OpenAI — https://platform.openai.com/api-keys  (optional; adds GPT models)
OPENAI_API_KEY=

# Cloudflare Workers AI  (optional)  — BOTH lines required, the endpoint is
# account-scoped. Token: My Profile ▸ API Tokens ▸ Create Token ▸ "Workers AI"
# (needs Workers AI:Read/Edit on the account — a zone-scoped token verifies fine
# but 401s here). Account id = the segment in your dashboard URL.
# Adds the free @cf/* models (gpt-oss-120b, llama-3.3-70b fast), which run on the
# account's neuron allocation. Partner models (google/gemini-3.6-flash) bill against
# an AI Gateway balance and 402 until it's funded — add them to CLOUDFLARE_MODEL
# (comma-separated) once you've topped it up.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Internals ─────────────────────────────────────────────────────────────────
# Shared secret between the runtime (:8765), the Workspace GUI (:1420) and the
# local helper (:8766). Any random string; it never leaves this machine.
CONNECT_AI_API_TOKEN=connect-ai-dev-token

# How long a turn may stay parked waiting for model quota to come back, in
# seconds (default 900). Set to 0 to disable waiting and fail immediately.
#COWORKER_QUOTA_WAIT_SECONDS=900
