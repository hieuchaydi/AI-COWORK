{
  "manifest_version": 3,
  "name": "AI Cowork — Browser Bridge",
  "version": "2.3.0",
  "description": "Realtime WebSocket Browser Bridge for user-authorized automation and ingest in a real Chrome profile.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "debugger",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI Cowork — Browser Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8766/*",
        "https://*.shopee.vn/*",
        "https://shopee.vn/*",
        "https://*.shoppe.vn/*",
        "https://shoppe.vn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
