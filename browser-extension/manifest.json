{
  "manifest_version": 3,
  "name": "AI Cowork — Browser Bridge",
  "version": "2.0.0",
  "description": "Realtime WebSocket Browser Bridge for user-authorized automation and ingest in a real Chrome profile.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI Cowork — Browser Bridge",
    "default_popup": "popup.html"
  }
}
